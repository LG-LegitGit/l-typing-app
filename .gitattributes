# Store and check out text files with LF line endings on every OS,
# overriding core.autocrlf (e.g. Git for Windows / GitHub Desktop).
* text=auto eol=lf

# Binary assets: never touch line endings or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.woff binary
*.woff2 binary
